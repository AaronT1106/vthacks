# Create an OAuth client in the Copernicus Data Space account settings.
SATELLITE_IMAGERY_PROVIDER=sentinel-2
COPERNICUS_CLIENT_ID=your_client_id_here
COPERNICUS_CLIENT_SECRET=your_client_secret_here
COPERNICUS_MAX_CLOUD_COVER=40
COPERNICUS_SEARCH_WINDOW_DAYS=14
COPERNICUS_ANALYSIS_MAX_DIMENSION=2048

# Flood/water segmentation model. Model weights are cached outside the repository.
FLOOD_MODEL_ID=gdurkin/segformer-b0-finetuned-segments-floods-S2
FLOOD_MODEL_REVISION=f94b7a0254011883dc17f04d88355f8e7adc5263

# NASA FIRMS Area API. Keep the real MAP_KEY only in ignored backend/.env.
NASA_FIRMS_MAP_KEY=your_map_key_here
NASA_FIRMS_SOURCE=VIIRS_NOAA21_NRT
NASA_FIRMS_DAY_RANGE=1

# Optional comma-separated OSM Overpass endpoints used in order for road routing.
OSMNX_OVERPASS_URLS=https://overpass.maprva.org/api,https://overpass.private.coffee/api,https://overpass-api.de/api
OSMNX_REQUEST_TIMEOUT_SECONDS=25

# Use "mock" to skip provider requests and show the manual-upload fallback.
# SATELLITE_IMAGERY_PROVIDER=mock
