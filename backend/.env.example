# Create an OAuth client in the Copernicus Data Space account settings.
SATELLITE_IMAGERY_PROVIDER=sentinel-2
COPERNICUS_CLIENT_ID=replace_with_client_id
COPERNICUS_CLIENT_SECRET=replace_with_client_secret
COPERNICUS_MAX_CLOUD_COVER=40
COPERNICUS_SEARCH_WINDOW_DAYS=14
COPERNICUS_ANALYSIS_MAX_DIMENSION=2048

# Use "mock" to skip provider requests and show the manual-upload fallback.
# SATELLITE_IMAGERY_PROVIDER=mock
