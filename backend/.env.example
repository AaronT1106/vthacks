# Use "mock" for credential-free deterministic demo metadata.
SATELLITE_IMAGERY_PROVIDER=mock

# Set the provider to "copernicus" and create an OAuth client in Copernicus Data Space.
COPERNICUS_CLIENT_ID=your_client_id
COPERNICUS_CLIENT_SECRET=your_client_secret

# Optional provider overrides.
COPERNICUS_COLLECTION=sentinel-2-l2a
COPERNICUS_STAC_URL=https://sh.dataspace.copernicus.eu/catalog/v1/search
COPERNICUS_TOKEN_URL=https://identity.dataspace.copernicus.eu/auth/realms/CDSE/protocol/openid-connect/token
